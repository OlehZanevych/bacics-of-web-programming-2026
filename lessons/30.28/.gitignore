.idea/
*.iml
*.ipr
*.iws
out/

# --- VS Code ------------------------------------------------------------------
# Особисті налаштування редактора (зокрема порт Live Server у settings.json).
.vscode/
*.code-workspace
.history/

# --- Файли операційних систем -----------------------------------------------
# macOS: службові файли Finder
.DS_Store
._*
# Windows: кеш мініатюр і службові файли провідника
Thumbs.db
desktop.ini

# --- Тимчасові файли редакторів ---------------------------------------------
*.swp
*~
